# ---------------------------------------------------------------------------
# Requirements Discovery Copilot — environment configuration (example)
# Copy to `.env` and adjust. NEVER commit a real .env with secrets.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# Docker Compose default. For local-only runs without Postgres you may use:
#   DATABASE_URL=sqlite+pysqlite:///./copilot.db
DATABASE_URL=postgresql+psycopg://copilot:copilot@db:5432/copilot
POSTGRES_USER=copilot
POSTGRES_PASSWORD=copilot
POSTGRES_DB=copilot

# --- Optional Redis (event bus / cache) -----------------------------------
# Leave EVENT_BUS=memory to run fully in-process.
EVENT_BUS=memory
REDIS_URL=redis://redis:6379/0

# --- Provider selection ---------------------------------------------------
# STT_PROVIDER: mock | replay | local | openai | wispr
STT_PROVIDER=mock
LLM_PROVIDER=mock
EMBEDDING_PROVIDER=mock
EXPORTER=default

# --- Transcription configuration -----------------------------------------
# Browser audio always targets the SpecLive WebSocket; never expose these
# credentials or provider names through NEXT_PUBLIC_* variables.
STT_LANGUAGE=en
# Set true only when the configured server-side transcription/diarization stack
# emits stable voice labels. The browser remains provider-neutral.
STT_SPEAKER_DETECTION=false
# STT_PROMPT=Requirements discovery call with product and customer terminology.

# Local faster-whisper (no API key; model is downloaded on first use)
FASTER_WHISPER_MODEL=small.en
FASTER_WHISPER_DEVICE=auto
FASTER_WHISPER_COMPUTE_TYPE=default
FASTER_WHISPER_CHUNK_SECONDS=3.0

# Scripted replay (STT_PROVIDER=replay): a test/demo diarization stand-in that
# replays a conversation fixture as anonymous detected voices. See scripts/README.md.
# REPLAY_SCRIPT=scripts/conversations/hpc_infrastructure.json
REPLAY_SECONDS_PER_TURN=2.5

# Hosted provider credentials (leave blank unless selected)
# OPENAI_API_KEY=
# OPENAI_REALTIME_MODEL=gpt-live-transcribe
# WISPR_FLOW_API_KEY=
# WISPR_FLOW_ACCESS_TOKEN=

# --- Other provider credentials ------------------------------------------
# ANTHROPIC_API_KEY=
# DEEPGRAM_API_KEY=

# --- API server -----------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
ENVIRONMENT=development

# --- Web app --------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000

# --- Data retention (placeholder policy — see SECURITY.md) ----------------
TRANSCRIPT_RETENTION_DAYS=90
ENABLE_TRANSCRIPT_REDACTION=false
